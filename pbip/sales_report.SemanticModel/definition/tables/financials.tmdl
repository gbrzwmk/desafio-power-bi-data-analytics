table financials
	lineageTag: e8984e47-1d48-449a-b98c-c9c571939304

	measure 'Máximo sold' = MAX(financials[Units Sold])
		lineageTag: 05bbd9e2-2283-44c8-810d-e116eb28cbc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'total sales' = ```
			SUMX(financials, financials[ Sales]) 
			```
		lineageTag: bc6fc5a1-40d1-46be-90a2-ba36530b5c45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TOP3 PRODUCT' = ```
			CALCULATE(
			    [total sales],
			    TOPN(
			        3, 
			        ALL(financials[Product]),
			        [total sales]), 
			    VALUES(financials[Product])
			    )
			```
		lineageTag: 43bbe98a-a342-4c2c-bde1-697a4946bf36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'total de vendidos' = SUMX(financials, financials[Units Sold])
		lineageTag: fc896139-301d-48ca-a813-a4f4ce2228be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure outlier = ```
			CALCULATE( 
			    [total de vendidos],
			    FILTER(
			        VALUES(financials[Product]),
			        COUNTROWS( FILTER(financials, [total de vendidos] >= 150)) > 0
			    )
			)
			```
		lineageTag: 835bf19a-ad1f-419a-9265-8b497eaa1b1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Meta = [total sales]*0.8
		lineageTag: 06d85844-29df-42c6-9092-dffaa42794dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'avg sales' = AVERAGEX(financials, financials[ Sales])
		lineageTag: 2efa1e5b-e370-4e70-be5f-d03de2bdab39

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Profit' = SUM(financials[Profit])
		formatString: #,0.00
		lineageTag: d26b92e5-c320-4001-a962-c27df72c2c26

	measure 'Total Discounts' = SUM(financials[Discounts])
		formatString: #,0.00
		lineageTag: 51c35f87-45cf-432b-a69f-8a0c89ce5ef7

	measure 'Margem de Lucro' = DIVIDE([Total Profit], [total sales])
		formatString: 0.0%
		lineageTag: 3167181e-b313-443f-a9c2-d822168e5087

	measure 'Ticket Médio' = DIVIDE([total sales], COUNTROWS(financials))
		formatString: #,0.00
		lineageTag: fd8055e8-ccdf-4401-a180-b36432793637

	measure 'Qtd Países' = DISTINCTCOUNT(financials[Country])
		formatString: 0
		lineageTag: 4a8bcbe1-0bb1-4336-ae9a-eec77c9881b1

	measure 'Ranking Produto' = RANKX(ALL(financials[Product]), [total sales])
		formatString: 0
		lineageTag: 3197e8d5-a502-4e47-af9f-a22b0746a9ba

	measure 'Vendas TOP3 (%)' = DIVIDE(CALCULATE([total sales], TOPN(3, ALL(financials[Product]), [total sales])), CALCULATE([total sales], ALL(financials[Product])))
		formatString: 0.0%
		lineageTag: 9a0c3eb1-5b7d-416f-aadb-1de832f9e2b0

	measure 'Unidades Médias por Mês' = AVERAGEX(VALUES(financials[Month Name]), [total de vendidos])
		formatString: #,0
		lineageTag: 4494a9a9-323b-4390-a35b-e040dd93fa0c

