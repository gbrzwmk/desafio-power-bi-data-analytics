	/// Clusters para Profit
	column 'Profit (clusters)' = ```
			VAR __ClusterValue = 
			  LOOKUPVALUE(
			    'ClusterMappingTable'[ClusterId],
			    'ClusterMappingTable'[Profit],
			    'financials'[Profit]
			  )
			
			RETURN
			  SWITCH(
			    __ClusterValue,
			    BLANK(),
			    BLANK(),
			    CONCATENATE("Cluster", __ClusterValue)
			  )
			```
