	column Buckets = ```
			VAR __Count = 10
			
			VAR __Min = MIN('financials'[Units Sold])
			
			VAR __Max = MAX('financials'[Units Sold])
			
			VAR __Difference = (__Max - __Min)
			
			VAR __Size = IF(__Difference > 0, __Difference / __Count, 1)
			
			VAR __BinNumber = 
			  IF(
			    ISBLANK('financials'[Units Sold]),
			    BLANK(),
			    ROUNDDOWN(('financials'[Units Sold] - __Min) / __Size, 0)
			  )
			
			RETURN
			  IF(
			    ISBLANK('financials'[Units Sold]),
			    BLANK(),
			    __Min + (MIN(__BinNumber, __Count - 1) * __Size)
			  )
			```
		lineageTag: 6ce2c8bd-07d0-4492-9764-18d75bf2d2e8
		summarizeBy: none

